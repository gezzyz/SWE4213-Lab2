meta {
  name: Create Product - Success
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "name": "USB-C Cable",
    "description": "High-speed USB-C charging and data cable",
    "price": 29.99
  }
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("Response contains created product", function() {
    const body = res.getBody();
    expect(body).to.be.an('object');
  });
  
  test("Response has id field", function() {
    const product = res.getBody();
    expect(product).to.have.property('id');
    expect(product.id).to.be.a('number');
    bru.setVar('newProductId', product.id);
  });
  
  test("Response contains submitted data", function() {
    const product = res.getBody();
    expect(product.name).to.equal('USB-C Cable');
    expect(product.description).to.equal('High-speed USB-C charging and data cable');
    expect(parseFloat(product.price)).to.equal(29.99);
  });
}
