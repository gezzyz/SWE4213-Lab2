meta {
  name: Get Order by ID - Success
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/orders/1
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("Status code is 200 or 404 (depending on seeded data)", function() {
    const status = res.getStatus();
    expect([200, 404]).to.include(status);
  });
  
  test("Response is an object if found", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body).to.be.an('object');
      expect(body).to.have.property('id');
      expect(body).to.have.property('user_id');
      expect(body).to.have.property('product_id');
      expect(body).to.have.property('quantity');
      expect(body).to.have.property('total_price');
    }
  });
}
