meta {
  name: Rate Limit Verification - Multiple Requests
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/api/orders
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "user_id": 1,
    "product_id": 1,
    "quantity": 1
  }
}

tests {
  test("First request succeeds (not rate limited)", function() {
    const status = res.getStatus();
    expect([200, 201, 400, 404, 503]).to.include(status);
  });
  
  test("Response includes rate limit headers", function() {
    const headers = res.getHeaders();
    expect(headers).to.have.property('ratelimit-limit');
    expect(headers).to.have.property('ratelimit-remaining');
    expect(headers).to.have.property('ratelimit-reset');
  });
  
  test("Rate limit is set to 100 requests per 15 minutes", function() {
    const headers = res.getHeaders();
    const limit = headers['ratelimit-limit'];
    expect(parseInt(limit)).to.equal(100);
  });
}
